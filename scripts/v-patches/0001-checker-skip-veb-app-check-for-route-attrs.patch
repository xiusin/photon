+// has_route_attr 判断方法是否带框架自定义的路由属性。
+//
+// veb 的自动参数填充只服务于它自己的路由注册；而 Photon 这类框架是在
+// comptime 里用 $for 直接派发控制器方法的，`(mut ctx, params map[string]string)`
+// 是框架自己的约定，跟 veb 的「参数从 URL 段填充」无关。凡是显式带
+// @[get]/@[post]/@[put]/@[delete]/@[patch]/@[route] 的方法都由此类框架接管，
+// 不该被 veb 的参数类型检查拦下 —— 否则「带路径参数的控制器方法」在
+// 0.5.2 下整体不可编译，而它恰恰是框架的核心用法。
+fn has_route_attr(attrs []ast.Attr) bool {
+	for attr in attrs {
+		name := attr.name.trim_space().to_lower()
+		if name in ['get', 'post', 'put', 'delete', 'patch', 'head', 'options', 'route'] {
+			return true
+		}
+	}
+	return false
+}
